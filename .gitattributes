# Текст — с нормализацией концов строк, чтобы diff между тегами не тонул в CRLF.
* text=auto
*.bat text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf
*.png binary
*.ico binary
# Код json_serializable лежит в git, чтобы проект собирался сразу после клона.
# GitHub сворачивает такие файлы в PR.
*.g.dart linguist-generated=true
